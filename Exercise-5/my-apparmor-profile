#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected) {
    #include <abstractions/base>

    # Allow the Flask application files
    /app/** rwk,

    # Allow basic network communication
    network inet stream,

    # Allow binding to the Flask port
    capability net_bind_service,

    # Deny access to sensitive system files
    deny /etc/** r,
    deny /var/** rw,
    deny /bin/** x,
    deny /usr/bin/** x,

    # Prevent administrative privileges
    deny capability sys_admin,
}